# ===========================================================================
# Multilingual file for the TOS 7 Docker application "delugedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================

[en-us]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge is a lightweight BitTorrent client with a full web interface. Add torrents, watch progress and manage seeds from any browser while the daemon keeps running in the container. It runs the official LinuxServer.io image as a non-root container; settings and downloads stay in the app data folder. No telemetry goes to the developer: only the trackers, DHT nodes and peers of the torrents you add see your IP. Web password is deluge; change it on first login."
release_note = "2.2.0-3: rectified per review comments - privacy policy and listings now describe the real traffic (trackers, DHT, peer exchange, release check) and disclose the third-party endpoints; the licence is corrected to GPL-3.0-or-later with the OpenSSL exception and NOTICE rewritten; README and repository layout completed; base image bumped to linuxserver/deluge:2.2.0-ls387 for the CVE report; aarch64 package rebuilt and verified to declare platform=aarch64."
important    = "Requires DockerEngine. Default web password 'deluge' - change it immediately. Only the web port is published; peers reach you through UPnP/NAT-PMP or router forwarding, while outgoing connections still download. Your public IP is visible to the trackers, DHT nodes and peers of every torrent you add; no VPN is included. Data lives in DockerAppData/delugedocker (config, downloads). The page is plain HTTP on the LAN."

[zh-cn]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge 是轻量级 BitTorrent 客户端，带完整 Web 界面。可在任意浏览器添加种子、查看进度、管理做种，守护进程持续在容器内运行。本应用运行 LinuxServer.io 官方镜像并以非 root 用户运行，配置与下载文件保存在应用数据目录。开发者不收集任何遥测数据：只有你添加的任务对应的 tracker、DHT 节点和 peer 会看到你的公网 IP。默认 Web 密码为 deluge，首次登录后请立即修改。"
release_note = "2.2.0-3：按审核意见整改——隐私声明与描述改为真实流量（tracker、DHT、peer 交换、版本检查）并补齐第三方端点表；许可更正为 GPL-3.0-or-later 及 OpenSSL 例外并重写 NOTICE；补全 README 与仓库目录；基础镜像升级到 linuxserver/deluge:2.2.0-ls387（对应 CVE 报告）；aarch64 包重新构建并核实 platform=aarch64。"
important    = "需要 DockerEngine。默认 Web 密码为 deluge，请立即修改。本包只发布 Web 端口，peer 入站依赖 UPnP/NAT-PMP 或路由器端口转发，出站连接仍可正常下载。你添加的每个任务都会把公网 IP 暴露给对应的 tracker、DHT 节点和 peer；本包不含 VPN。数据在 DockerAppData/delugedocker（config、downloads）。页面是局域网明文 HTTP。"

[zh-hk]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge 是輕量級 BitTorrent 用戶端，帶完整 Web 介面。可在任意瀏覽器新增種子、查看進度、管理做種，守護程式持續在容器內執行。本應用執行 LinuxServer.io 官方鏡像並以非 root 使用者執行，設定與下載檔案儲存在應用程式資料目錄。開發者不收集任何遙測資料：只有你新增的任務對應的 tracker、DHT 節點與 peer 會看到你的公網 IP。預設 Web 密碼為 deluge，首次登入後請立即修改。"
release_note = "2.2.0-3：按審核意見整改——隱私聲明與描述改為真實流量（tracker、DHT、peer 交換、版本檢查）並補齊第三方端點表；許可更正為 GPL-3.0-or-later 及 OpenSSL 例外並重寫 NOTICE；補全 README 與倉庫目錄；基礎鏡像升級到 linuxserver/deluge:2.2.0-ls387（對應 CVE 報告）；aarch64 包重新建置並核實 platform=aarch64。"
important    = "需要 DockerEngine。預設 Web 密碼為 deluge，請立即修改。本包只發布 Web 連接埠，peer 入站依賴 UPnP/NAT-PMP 或路由器連接埠轉送，出站連線仍可正常下載。你新增的每個任務都會把公網 IP 暴露給對應的 tracker、DHT 節點與 peer；本包不含 VPN。資料在 DockerAppData/delugedocker（config、downloads）。頁面是區域網路明文 HTTP。"

