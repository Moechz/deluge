# ===========================================================================
# Multilingual file for the TOS 7 Docker application "delugedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge is a lightweight BitTorrent client with a full web interface. Add torrents, watch progress and manage seeds from any browser on your network while the daemon keeps running in the container. This package runs the official LinuxServer.io Deluge image as a non-root container; its configuration and downloaded files live in the application data folder. The default web password is deluge; change it on first login."
release_note = "1. First release: Deluge 2.2.0 from Docker Hub, running as a non-root container; configuration and downloads live in the application data folder."
important    = "Requires DockerEngine. The default web password is 'deluge' - change it immediately. Only the web port is published, so incoming peer connections rely on UPnP/NAT-PMP or router port forwarding; downloads still work with outgoing connections. Files are stored in DockerAppData/delugedocker (config and downloads) and are not shared with other apps. Back up the folder before uninstalling with data removal. The page is plain HTTP on the LAN."

[zh-cn]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge 是轻量级 BitTorrent 客户端，带完整 Web 界面。可以在局域网内任意浏览器添加种子、查看进度和管理做种，守护进程持续在容器中运行。本应用运行 LinuxServer.io 官方镜像并以非 root 用户运行；配置和下载文件保存在应用数据目录。默认 Web 密码是 deluge，首次登录后请立即修改。"
release_note = "1. 首个版本：Deluge 2.2.0，来自 Docker Hub，以非 root 用户运行；配置与下载文件保存在应用数据目录。"
important    = "需要 DockerEngine。默认 Web 密码为 deluge，请立即修改。本包只发布 Web 端口，入站连接依赖路由器 UPnP/NAT-PMP 或端口转发；出站连接仍可正常下载。文件在 DockerAppData/delugedocker（config 与 downloads），与其他应用不共享。卸载并删除数据前请备份。页面是局域网明文 HTTP。"

[zh-hk]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge 是輕量級 BitTorrent 用戶端，帶完整 Web 介面。可以在區域網路內任意瀏覽器新增種子、查看進度和管理做種，守護程式持續在容器中執行。本應用執行 LinuxServer.io 官方鏡像並以非 root 使用者執行；設定和下載檔案儲存在應用程式資料目錄。預設 Web 密碼是 deluge，首次登入後請立即修改。"
release_note = "1. 首個版本：Deluge 2.2.0，來自 Docker Hub，以非 root 使用者執行；設定與下載檔案儲存在應用程式資料目錄。"
important    = "需要 DockerEngine。預設 Web 密碼為 deluge，請立即修改。本包只發布 Web 連接埠，入站連線依賴路由器 UPnP/NAT-PMP 或連接埠轉送；出站連線仍可正常下載。檔案在 DockerAppData/delugedocker（config 與 downloads），與其他應用不共享。解除安裝並刪除資料前請備份。頁面是區域網路明文 HTTP。"

