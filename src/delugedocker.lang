# ===========================================================================
# Multilingual file for the TOS 7 Docker application "delugedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language.
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from the tosapp.json "translations" block, run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating.
# ASCII semicolons are forbidden in every value: the store parser treats
# them as an INI comment and cuts the description there.
# ===========================================================================
[en-us]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge is a BitTorrent client. Its daemon runs in the container and is driven from the Deluge Web UI on port 8020. Sign in with the default password deluge, then change it. The Web UI adds torrent files, magnet links and URLs, shows download and seeding progress and sets speed limits. Settings and resume data stay in DockerAppData/delugedocker/config, the payload in downloads. Only the Web UI port is published, so incoming peers need a forwarded port on the router. No telemetry is sent to the developer."
release_note = "2.2.0-4: rectified per review comments. F2 fixed: /run is pre-mounted as a tmpfs owned by uid 1000, so s6-overlay no longer aborts with exit code 100 before Deluge starts. C9 fixed: app.lang no longer uses ASCII semicolons, which the store parser treated as a comment and cut the description, and the text describes only delivered features. P2 fixed: help points to a rendered help page. S11 fixed: umask 027 and owner-only /config. T1 fixed: image bumped to ls388."
important    = "Default Web UI password is deluge, change it on first login. Only port 8020 (Web UI) is published. Incoming peer connections need a listen port forwarded on the router, outgoing connections work without it. Your public IP is sent to the trackers, DHT nodes and peers of every torrent you add and no VPN is included. Data lives in DockerAppData/delugedocker. The page is plain HTTP on the LAN, so use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge 是 BitTorrent 客户端，守护进程在容器内运行，通过 8020 端口的 Deluge Web 界面操作。默认密码为 deluge，请首次登录后立即修改。在 Web 界面可添加种子文件、磁力链与下载地址，查看下载与做种进度并设置限速。配置与断点续传数据保存在 DockerAppData/delugedocker/config，下载内容保存在 downloads。应用只发布 Web 端口，入站 peer 需要在路由器上转发端口。开发者不收集任何遥测数据。"
release_note = "2.2.0-4：按审核意见整改。F2 修复：/run 预挂载为 uid 1000 的 tmpfs，s6-overlay 不再以退出码 100 中断启动。C9 修复：lang 不再使用 ASCII 分号（商店解析器会当作注释截断描述），文案只描述真实交付的功能。P2 修复：help 指向可渲染的帮助页。S11 修复：umask 027 且 /config 仅属主可读。T1 修复：基础镜像升级到 ls388。"
important    = "默认 Web 密码为 deluge，请首次登录后立即修改。本包只发布 8020 端口（Web 界面）。入站 peer 连接需要在路由器上转发监听端口，出站连接不受影响。你添加的每个任务都会把公网 IP 暴露给对应的 tracker、DHT 节点与 peer，本包不含 VPN。数据位于 DockerAppData/delugedocker。页面是局域网明文 HTTP，暴露到公网前请使用 TLS 反向代理。"

[zh-hk]
name         = "Deluge"
auth         = "linuxserver.io"
version      = "@@VERSION@@"
descript     = "Deluge 是 BitTorrent 用戶端，守護程式在容器內執行，透過 8020 連接埠的 Deluge Web 介面操作。預設密碼為 deluge，請首次登入後立即修改。在 Web 介面可新增種子檔案、磁力鏈與下載位址，查看下載與做種進度並設定限速。設定與斷點續傳資料儲存在 DockerAppData/delugedocker/config，下載內容儲存在 downloads。應用只發布 Web 連接埠，入站 peer 需要在路由器上轉送連接埠。開發者不收集任何遙測資料。"
release_note = "2.2.0-4：按審核意見整改。F2 修復：/run 預掛載為 uid 1000 的 tmpfs，s6-overlay 不再以退出碼 100 中斷啟動。C9 修復：lang 不再使用 ASCII 分號（商店解析器會當作註解截斷描述），文案只描述真實交付的功能。P2 修復：help 指向可渲染的說明頁。S11 修復：umask 027 且 /config 僅屬主可讀。T1 修復：基礎鏡像升級到 ls388。"
important    = "預設 Web 密碼為 deluge，請首次登入後立即修改。本包只發布 8020 連接埠（Web 介面）。入站 peer 連線需要在路由器上轉送監聽連接埠，出站連線不受影響。你新增的每個任務都會把公網 IP 暴露給對應的 tracker、DHT 節點與 peer，本包不含 VPN。資料位於 DockerAppData/delugedocker。頁面是區域網路明文 HTTP，暴露到公網前請使用 TLS 反向代理。"

