# --- build products (the package is distributed through GitHub Releases) ---
/build/
/out/

# --- generated copy used for manual compose testing ---
/test/compose-resolved/

# --- internal project documents: kept locally, never published ---
AGENTS.md
HANDOFF.md
# NOTE: docs/ is deliberately NOT ignored. docs/index.md is the rendered help
# page published by GitHub Pages (https://moechz.github.io/deluge/), which is
# the `help` URL of the package (finding P2).

# --- local packaging toolkit copy and spec (never published) ---
/.toolkit/
/specs/

# --- build machine noise ---
.DS_Store
._*

# --- local packaging helpers (never published) ---
/.gitconfig-local
